# ---- AWS / Bedrock ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Most current Claude models on Bedrock are INFERENCE_PROFILE-only: the bare
# model id (anthropic.claude-sonnet-5) cannot be invoked and fails with a
# ValidationException that never mentions inference profiles. Use the profile id.
# Verify with: pytest -m integration -k invokable
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024
# cohere (hosted, production) | bedrock (Titan) | fastembed (local ONNX, zero-cost dev).
# Different vector spaces: each gets its own collection automatically.
EMBEDDING_BACKEND=cohere
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIM=1024
COHERE_RERANK_MODEL=rerank-v3.5
# Embed tokens/minute budget; trial keys are capped at 100000 (0 disables pacing)
COHERE_EMBED_TPM=100000
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_DIM=384

# ---- Output guardrails: Bedrock ApplyGuardrail (wraps Groq answers too) ----
# bedrock | none. Use none while the account cannot invoke bedrock-runtime.
OUTPUT_GUARD_BACKEND=none
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# FULL returns every assessment (useful for tuning); INTERVENTIONS only what fired
OUTPUT_GUARD_SCOPE=FULL

# ---- Input guardrails: length, language, PII, prompt injection ----
INPUT_GUARD_ENABLED=true
# guardrails_ai | native (same checks; the framework's telemetry is forced off)
INPUT_GUARD_ENGINE=guardrails_ai
# groq_prompt_guard | none. Groq's hosted classifier, called directly (not via Portkey)
INJECTION_BACKEND=groq_prompt_guard
INJECTION_MODEL_ID=meta-llama/llama-prompt-guard-2-86m
INJECTION_THRESHOLD=0.5
# A guard that cannot run fails closed unless this is true
INPUT_GUARD_FAIL_OPEN=false
# /query/stream holds this many chars and checks them before emitting
STREAM_WINDOW_CHARS=300

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=rbi_circulars

# ---- LLM gateway ----
# portkey (production: routing + fallback) | bedrock (direct, M2 check only)
LLM_BACKEND=portkey
# Primary target in the fallback chain: any Portkey Model Catalog provider slug
# and that provider's model id. Has been @aws/us.anthropic.claude-sonnet-5,
# @anthropic/claude-sonnet-5 and @google/gemini-3.5-flash with no code change.
LLM_PRIMARY_PROVIDER=@google
LLM_PRIMARY_MODEL=gemini-3.5-flash
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# RAGAS judge. Blank = judge through the gateway config (the generator itself).
# A different model avoids self-preference and a shared free-tier daily quota.
RAGAS_JUDGE_PROVIDER=@google
RAGAS_JUDGE_MODEL=gemini-3-flash-preview
# Saved config slug from the Portkey dashboard (pc-...). Required on accounts
# with block_inline_config; print the JSON to save with:
#   python -m generation.gateway
PORTKEY_CONFIG_SLUG=
# Model Catalog provider slugs as created in the Portkey dashboard
PORTKEY_BEDROCK_PROVIDER=@aws
PORTKEY_GROQ_PROVIDER=@groq
GROQ_API_KEY=
# Groq retired Llama 3 chat models; check https://api.groq.com/openai/v1/models
GROQ_MODEL_ID=openai/gpt-oss-120b
# Reasoning models spend the whole budget thinking without this; Groq target only
GROQ_REASONING_EFFORT=low
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_SERVICE_NAME=rag-system

# ---- Retrieval / generation tuning ----
# fixed | recursive | semantic. fixed measured best; see evaluation/results/compare_chunking_ctx_*.md
CHUNK_STRATEGY=fixed
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# semantic only: boundary where adjacent-sentence distance exceeds this percentile
SEMANTIC_BREAKPOINT_PERCENTILE=90
# Prepend title | circular no | date to each chunk's retrieval text (its own collection)
CHUNK_CONTEXT_HEADER=false
TOP_K=20
# dense | hybrid (dense + BM25 fused by RRF on the Qdrant server)
RETRIEVAL_MODE=dense
PREFETCH_K=40
RERANK_TOP_N=5
# cohere (hosted) | cross_encoder (local) | bedrock | none
RERANKER_BACKEND=cohere
# Threshold scale depends on RERANKER_BACKEND (logits vs 0-1 vs RRF).
# Leave unset to use the backend's calibrated default.
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Only for RERANKER_BACKEND=bedrock; Rerank is available in fewer regions than Bedrock
BEDROCK_RERANK_MODEL_ARN=
BEDROCK_RERANK_REGION=
RELEVANCE_THRESHOLD=
MAX_QUESTION_CHARS=1000
