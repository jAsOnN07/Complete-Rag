# ---- AWS / Bedrock ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Most current Claude models on Bedrock are INFERENCE_PROFILE-only: the bare
# model id (anthropic.claude-sonnet-5) cannot be invoked and fails with a
# ValidationException that never mentions inference profiles. Use the profile id.
# Verify with: pytest -m integration -k invokable
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024
# bedrock (Titan, production) | fastembed (local ONNX, dev while Bedrock is down).
# Different vector spaces: each gets its own collection automatically.
EMBEDDING_BACKEND=bedrock
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_DIM=384

# ---- Bedrock Guardrails (output path) ----
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=rbi_circulars

# ---- LLM gateway ----
# portkey (production: routing + Bedrock->Groq fallback) | bedrock (direct, M2 check only)
LLM_BACKEND=portkey
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Saved config slug from the Portkey dashboard (pc-...). Required on accounts
# with block_inline_config; print the JSON to save with:
#   python -m generation.gateway
PORTKEY_CONFIG_SLUG=
# Model Catalog provider slugs as created in the Portkey dashboard
PORTKEY_BEDROCK_PROVIDER=@aws
PORTKEY_GROQ_PROVIDER=@groq
GROQ_API_KEY=
# Groq retired Llama 3 chat models; check https://api.groq.com/openai/v1/models
GROQ_MODEL_ID=openai/gpt-oss-120b
# Reasoning models spend the whole budget thinking without this; Groq target only
GROQ_REASONING_EFFORT=low
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_SERVICE_NAME=rag-system

# ---- Retrieval / generation tuning ----
CHUNK_STRATEGY=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=20
RERANK_TOP_N=5
RERANKER_BACKEND=cross_encoder
# Threshold scale depends on RERANKER_BACKEND (logits vs 0-1 vs RRF).
# Leave unset to use the backend's calibrated default.
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RELEVANCE_THRESHOLD=
MAX_QUESTION_CHARS=1000
